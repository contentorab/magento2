{
  "name": "contentorab/localizationapi",
  "description": "A Magento 2 module that sends and receives product attributes for localization by Contentor",
  "type": "magento2-module",
  "version": "1.0.2",
  "license": [
    "OSL-3.0"
  ],
  "require": {
    "ext-curl": "*"
  },
  "repositories": {
    "meqp": {
        "type": "git",
        "url": "https://github.com/magento/marketplace-eqp.git"
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.3.0",
    "magento-ecg/coding-standard": "^3.1",
    "magento/marketplace-eqp": "dev-master",
    "wimg/php-compatibility": "^8.1.0"
  },
  "autoload": {
    "files": [ "registration.php" ],
    "psr-4": {
      "Contentor\\LocalizationApi\\": ""
    }
  }
}

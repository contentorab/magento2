<p>
<h2>Delivery Speed</h2>
<?php

use Magento\Framework\View\Element\Template;

/** @var Template $block */
$deliveryExpressViewModel = $block->getData('deliveryExpressViewModel');
$deliveryOptions = $deliveryExpressViewModel ? $deliveryExpressViewModel->getConfig() : '';
?>
<select name="deliverySpeed">
    <?php
    foreach ($deliveryOptions as $option) {
        print '<option value="' . $escaper->escapeHtmlAttr($option['value']) . '"';
        if ($option['value'] == 'normal') {
            print ' SELECTED';
        }
        print '>' . $escaper->escapeHtml($option['label']) . '</option>';
    }
    ?>
</select>
</p>

                    <input <?= $config['field_type'] == 'context' ? "style='display:none'" : '' ?> type="text" id="<?= $escaper->escapeHtmlAttr($config['attribute']) ?>_word_count"
                           name="attributesConfig[<?= $escaper->escapeHtmlAttr($config['attribute']) ?>][word_count]" value="<?= $escaper->escapeHtmlAttr($config['word_count']); ?>" class="required-entry">
                </td>
                <td>
                    <p><?= $escaper->escapeHtml(ucfirst($config['field_type'])); ?></p>
                    <input readonly="readonly"  type="hidden" id="<?= $escaper->escapeHtmlAttr($config['attribute']) ?>_field_type"

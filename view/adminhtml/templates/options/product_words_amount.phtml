<?php

use Contentor\LocalizationApi\Service\ConfigurationService;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
$isCategory = $block->getData('isCategory');
$dataViewModel = $block->getData('dataViewModel');
if ($isCategory) {
    $path = ConfigurationService::XML_PATH_CATEGORY_CONTENT_CREATION_FIELDS;
} else {
    $path = ConfigurationService::XML_PATH_CONTENT_CREATION_FIELDS;
}

$contentCreationAttributesConfig = $dataViewModel ? $dataViewModel->getConfig($path) : '';

$contentCreationAttributesConfig = json_decode($contentCreationAttributesConfig, true);
$id = time();
?>

<table class="admin__control-table" id="contentor_options_contentCreation_fieldDetails">
    <thead>
        <tr>
            <th><?= __('Attributes') ?></th>
            <th><?= __('Amount Of Words') ?></th>
            <th><?= __('Field Type') ?></th>
            <th><?= __('Context Value') ?></th>
        </tr>
    </thead>
    <tbody id="configAttributesContentCreation">
        <?php foreach ($contentCreationAttributesConfig as $key => $config): ?>
            <tr id="_<?= $escaper->escapeHtmlAttr($key) ?>">
                <td> <p><?= $escaper->escapeHtml(ucfirst($config['attribute'])); ?></p> </td>

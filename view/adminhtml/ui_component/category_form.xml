            </argument>
            <htmlContent name="html_content">
                <argument name="block" xsi:type="object">Contentor\LocalizationApi\Block\Adminhtml\Catalog\Category\Edit\Tab\Localization</argument>
            </htmlContent>
        </container>
    </fieldset>

    <fieldset name="contentor_creatable_fieldset">

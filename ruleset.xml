<?xml version="1.0"?>
<!--

Configuration PHP CodeSniffer that checks that we follow the Magento guidelines
and that we keep compatibility with older PHP versions.

-->
<ruleset name="ExtensionStandard">
	<config name="installed_paths" value="vendor/magento-ecg/coding-standard/,vendor/magento/marketplace-eqp/,vendor/wimg/php-compatibility/" />
	<config name="testVersion" value="5.4"/>

	<rule ref="./vendor/magento-ecg/coding-standard/Ecg" />
	<rule ref="./vendor/magento/marketplace-eqp/MEQP1" />
	<rule ref="./vendor/wimg/php-compatibility/PHPCompatibility" />

	<exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>dev/*</exclude-pattern>
</ruleset>

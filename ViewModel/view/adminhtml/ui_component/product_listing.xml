<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<listingToolbar name="listing_top">
        <massaction name="listing_massaction">
            <action name="contentor_send_localization">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="type" xsi:type="string">contentor_send_localization</item>
                        <item name="label" xsi:type="string" translate="true">Send for Localization</item>
                        <item name="url" xsi:type="url" path="contentor/administration/postbulkproducts"/>
                    </item>
                </argument>
            </action>
            <action name="contentor_send_content_creation">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="type" xsi:type="string">contentor_send_content_creation</item>
                        <item name="label" xsi:type="string" translate="true">Send for Content Creation</item>
                        <item name="url" xsi:type="url" path="contentor/administration/contentcreation_postbulkproducts"/>
                    </item>
                </argument>
            </action>
        </massaction>
    </listingToolbar>
</listing>
